// Processes declare bioconda packages. On cloud executors, containers are built
// from those specs by Wave (wave.strategy = 'conda'); alternatively pin
// process.container per process to verified quay.io/biocontainers tags.
profiles {
    standard {
        process.executor = 'local'
        conda.enabled = true
    }
    awsbatch {
        process.executor = 'awsbatch'
        process.queue = System.getenv('NXF_AWS_QUEUE') ?: 'bioagent-queue'
        aws.region = System.getenv('AWS_REGION') ?: 'us-east-1'
        wave.enabled = true
        wave.strategy = 'conda'
        fusion.enabled = true
    }
    k8s {
        process.executor = 'k8s'
        k8s.storageClaimName = System.getenv('NXF_K8S_PVC') ?: 'bioagent-pvc'
        k8s.storageMountPath = '/workspace'
        wave.enabled = true
        wave.strategy = 'conda'
    }
}
